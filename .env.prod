# Production build configuration - Minimal logging
# This file is automatically loaded by build_stealth.bat when building production

# Disable action logging (no per-key logging)
AUTO_MAPLE_ACTION_LOG=0

# Only log ERROR and CRITICAL (no DEBUG/INFO/WARNING)
AUTO_MAPLE_LOG_LEVEL=ERROR

# Disable console output
AUTO_MAPLE_CONSOLE=0

# Light build (exclude TensorFlow)
AUTO_MAPLE_LIGHT_BUILD=1

# Log Encryption Key (32 bytes)
AUTO_MAPLE_LOG_ENCRYPTION_KEY=20ffe85ffd3d6f3778273b48ad7c4795232415aecbe13226358f9740c3908f7b
AUTO_MAPLE_LOG_ENCRYPTION=1
